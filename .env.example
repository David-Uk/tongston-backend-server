# ---------------------------------------------------------------------------
# T-World Module Service — backend environment
# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).
# Required variables cause a fast, readable boot failure when missing/invalid.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated origins; no wildcard in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info

# --- Database (MongoDB Atlas M0, or local Mongo via docker compose) ---------
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# Local: mongodb://127.0.0.1:27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=t_world

# --- Auth -------------------------------------------------------------------
# Must be >= 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

# --- AI orchestration -------------------------------------------------------
# mock | real (real requires AI_API_KEY)
AI_PROVIDER=mock
AI_API_KEY=
AI_TIMEOUT_MS=8000
AI_MAX_RETRIES=2
AI_MOCK_LATENCY_MS=1200
# 0 = never fail, 1 = always fail (0-1). Useful for demoing fallback paths.
AI_MOCK_FAILURE_RATE=0

# --- Token economy ----------------------------------------------------------
TOKENS_PER_AI_RUN=5
RATE_TOKENS_PER_MOCK_USDT=100
# 20,000 tokens -> 1 MOCK_ETH (i.e. 200 tokens -> 0.01 MOCK_ETH)
RATE_TOKENS_PER_MOCK_ETH=20000
MIN_CONVERT_AMOUNT=100

# --- Cloudinary (short-term media storage) ----------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Long-term storage ------------------------------------------------------
# s3 | mock. In mock mode no AWS credentials are required.
STORAGE_LONGTERM_MODE=mock
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Optional: MinIO / LocalStack endpoint, e.g. http://localhost:9000
S3_ENDPOINT=

# --- Upload limits ----------------------------------------------------------
MAX_UPLOAD_MB=10
ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,application/pdf

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=10
